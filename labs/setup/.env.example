# Course environment template — copy it to the repo root as `.env`:
#     cp labs/setup/.env.example .env
# `.env` is git-ignored. Put your keys there, never in a notebook or a commit.
# Model IDs are public defaults verified on 2026-10-27; change them here, not in code.

# Which provider Phase 2 labs use through labs/setup/llm.py:
#   openai | anthropic                  the providers' own APIs (every module)
#   azure-openai | azure-anthropic      Azure OpenAI or Claude on Microsoft Foundry (Module 3 onwards)
LLM_PROVIDER=openai

# OpenAI (Responses API). OPENAI_SMALL_MODEL must accept reasoning effort "none"
# (gpt-6-luna and gpt-6.1-terra do), because Module 1 Lab 01 sweeps temperature with it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
OPENAI_SMALL_MODEL=gpt-6-luna
# Embeddings (Anthropic has no embedding model of its own; local Sentence Transformers cover Claude-based labs)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Anthropic Claude (Messages API)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_SMALL_MODEL=claude-haiku-5-5

# Azure (Module 3 onwards, optional): only for LLM_PROVIDER=azure-openai | azure-anthropic.
# The *_DEPLOYMENT values are the deployment names you created, not base model IDs.
# Name deployments after their model (Azure's default) so LlamaIndex recognises them.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_SMALL_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
# Claude on Microsoft Foundry: the resource name from https://<resource>.services.ai.azure.com
ANTHROPIC_FOUNDRY_API_KEY=
ANTHROPIC_FOUNDRY_RESOURCE=
ANTHROPIC_FOUNDRY_DEPLOYMENT=
ANTHROPIC_FOUNDRY_SMALL_DEPLOYMENT=

# Embeddings for RAG (Module 3 onwards): local | openai | azure-openai.
# local runs ST_MODEL on your laptop: free, offline, multilingual, and no text leaves the machine.
EMBEDDING_PROVIDER=local
ST_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Pinecone managed vector database (Module 3 Lab 03, optional). Without a key the lab uses Chroma.
# The Starter plan creates serverless indexes in aws/us-east-1 only. In a shared project,
# give every learner their own PINECONE_INDEX (lower-case letters, digits, hyphens; max 45).
PINECONE_API_KEY=
PINECONE_INDEX=
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Tracing (Modules 2, 4 and 5)
LANGSMITH_TRACING=
LANGSMITH_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# Web search tool (Module 2). Labs fall back to a mock search tool when empty.
TAVILY_API_KEY=

# Episodic memory store (Module 4). Labs fall back to an in-memory store when empty.
REDIS_URL=

# Instructor only: Module 1 cloud OCR demo (Azure AI Vision). Leave empty as a participant.
AZURE_VISION_ENDPOINT=
AZURE_VISION_KEY=
