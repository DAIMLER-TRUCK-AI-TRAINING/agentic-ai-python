# Copy this file to .env, set LLM_PROVIDER and EMBEDDING_PROVIDER, and fill in the blocks they use
# Never commit .env to git
# The names match the repo-root .env (labs/setup/.env.example), so that file works here too

# Which chat model answers: openai | anthropic | azure-openai | azure-anthropic   (default: openai)
LLM_PROVIDER=openai

# Which model embeds the documents and questions: local | openai | azure-openai   (default: local)
# Claude has no embedding model; local runs on this machine with no key and no text leaving it.
EMBEDDING_PROVIDER=local
# Optional, local only: the Sentence Transformers model (default: the course's multilingual model)
ST_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# How many chunks to retrieve per question (default: 3)
RAG_TOP_K=3

# --- openai (OpenAI API) ---
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-6.1-sol
# Used when EMBEDDING_PROVIDER=openai (default: text-embedding-3-small)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Optional, OpenAI reasoning models only: a low effort shortens time-to-first-token.
# Leave empty for the model's default; valid values depend on the model.
OPENAI_REASONING_EFFORT=

# --- anthropic (Claude API) ---
ANTHROPIC_API_KEY=your_anthropic_key_here
ANTHROPIC_MODEL=claude-opus-5-5

# --- azure-openai (Azure OpenAI) ---
AZURE_OPENAI_API_KEY=your_azure_openai_key_here
# Resource endpoint only, no path (Azure portal > your resource > Keys and Endpoint)
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com
# Your deployment names, not the base model names
AZURE_OPENAI_DEPLOYMENT=your_deployment_name_here
# Used when EMBEDDING_PROVIDER=azure-openai, e.g. a text-embedding-3-small deployment
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=your_embedding_deployment_name_here

# --- azure-anthropic (Claude on Microsoft Foundry) ---
ANTHROPIC_FOUNDRY_API_KEY=your_azure_foundry_key_here
# Resource name only: the <resource> part of https://<resource>.services.ai.azure.com
ANTHROPIC_FOUNDRY_RESOURCE=your-resource-name
# Your deployment name, not the base model name (often the same, e.g. claude-opus-5-5)
ANTHROPIC_FOUNDRY_DEPLOYMENT=your_deployment_name_here
