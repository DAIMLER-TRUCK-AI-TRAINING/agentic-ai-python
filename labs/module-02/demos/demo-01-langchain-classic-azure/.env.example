# copy this file to .env and fill in the block for the provider you use

# Which model to call, both hosted in Azure: openai | anthropic   (default: openai)
LLM_PROVIDER=openai

# --- openai (Azure OpenAI) ---
AZURE_OPENAI_API_KEY=your_azure_openai_key_here
# Resource endpoint only, no path (Azure portal > your resource > Keys and Endpoint)
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com
# Your deployment name, not the base model name
AZURE_OPENAI_DEPLOYMENT=your_deployment_name_here

# --- anthropic (Claude on Microsoft Foundry) ---
ANTHROPIC_FOUNDRY_API_KEY=your_azure_foundry_key_here
# Resource name only: the <resource> part of https://<resource>.services.ai.azure.com
ANTHROPIC_FOUNDRY_RESOURCE=your-resource-name
# Your deployment name, not the base model name (often the same, e.g. claude-opus-5-5)
ANTHROPIC_FOUNDRY_DEPLOYMENT=your_deployment_name_here
