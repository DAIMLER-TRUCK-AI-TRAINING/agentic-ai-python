# Copy this file to .env, set LLM_PROVIDER and fill in the block for that provider
# Never commit .env to git
# The names match the repo-root .env (labs/setup/.env.example), so that file works here too

# Which model to call: openai | anthropic | azure-openai | azure-anthropic   (default: openai)
LLM_PROVIDER=openai

# --- openai (OpenAI API) ---
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-6.1-sol
# Optional, OpenAI reasoning models only: a low effort shortens time-to-first-token.
# Leave empty for the model's default; valid values depend on the model.
OPENAI_REASONING_EFFORT=

# --- anthropic (Claude API) ---
ANTHROPIC_API_KEY=your_anthropic_key_here
ANTHROPIC_MODEL=claude-opus-5-5

# --- azure-openai (Azure OpenAI) ---
AZURE_OPENAI_API_KEY=your_azure_openai_key_here
# Resource endpoint only, no path (Azure portal > your resource > Keys and Endpoint)
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com
# Your deployment name, not the base model name
AZURE_OPENAI_DEPLOYMENT=your_deployment_name_here

# --- azure-anthropic (Claude on Microsoft Foundry) ---
ANTHROPIC_FOUNDRY_API_KEY=your_azure_foundry_key_here
# Resource name only: the <resource> part of https://<resource>.services.ai.azure.com
ANTHROPIC_FOUNDRY_RESOURCE=your-resource-name
# Your deployment name, not the base model name (often the same, e.g. claude-opus-5-5)
ANTHROPIC_FOUNDRY_DEPLOYMENT=your_deployment_name_here
